<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>CFBundleDevelopmentRegion</key>
        <string>en</string>
        <key>CFBundleDisplayName</key>
        <string>Guru4pets</string>
        <key>CFBundleExecutable</key>
        <string>$(EXECUTABLE_NAME)</string>
        <key>CFBundleIdentifier</key>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
        <key>CFBundleInfoDictionaryVersion</key>
        <string>6.0</string>
        <key>CFBundleName</key>
        <string>$(PRODUCT_NAME)</string>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleShortVersionString</key>
        <string>$(MARKETING_VERSION)</string>
        <key>CFBundleVersion</key>
        <string>$(CURRENT_PROJECT_VERSION)</string>
        <key>LSRequiresIPhoneOS</key>
        <true/>
        <key>UILaunchStoryboardName</key>
        <string>LaunchScreen</string>
        <key>UIMainStoryboardFile</key>
        <string>Main</string>
        <key>UIRequiredDeviceCapabilities</key>
        <array>
                <string>armv7</string>
        </array>
        <key>UISupportedInterfaceOrientations</key>
        <array>
                <string>UIInterfaceOrientationPortrait</string>
                <string>UIInterfaceOrientationLandscapeLeft</string>
                <string>UIInterfaceOrientationLandscapeRight</string>
        </array>
        <key>UISupportedInterfaceOrientations~ipad</key>
        <array>
                <string>UIInterfaceOrientationPortrait</string>
                <string>UIInterfaceOrientationPortraitUpsideDown</string>
                <string>UIInterfaceOrientationLandscapeLeft</string>
                <string>UIInterfaceOrientationLandscapeRight</string>
        </array>
        <key>UIViewControllerBasedStatusBarAppearance</key>
        <true/>
        <!-- Privacy purpose strings (required by App Store review / fixes ITMS-90683).
             OneSignal and Capacitor reference these APIs even if the app does not
             actively use them, so Apple requires a user-facing purpose string. -->
        <key>NSLocationWhenInUseUsageDescription</key>
        <string>Guru4Pets utiliza tu ubicación para mostrarte servicios y profesionales de mascotas cerca de ti.</string>
        <key>NSCameraUsageDescription</key>
        <string>Guru4Pets necesita acceso a tu cámara para tomar fotos de tu mascota.</string>
        <key>NSPhotoLibraryUsageDescription</key>
        <string>Guru4Pets necesita acceso a tus fotos para seleccionar imágenes de tu mascota.</string>
        <!-- Required by OneSignal so the app can receive remote push notifications in the background -->
        <key>UIBackgroundModes</key>
        <array>
                <string>remote-notification</string>
        </array>
        <!-- Allow the app to query/handle OAuth provider URL schemes so that
             "Continue with Google" / "Continue with Apple" can launch the native
             provider apps when available and return to the app. -->
        <key>LSApplicationQueriesSchemes</key>
        <array>
                <string>https</string>
                <string>googlechrome</string>
                <string>googlechromes</string>
                <string>google</string>
                <string>com.google.gppconsent</string>
                <string>com.googleusercontent.apps</string>
                <string>fbapi</string>
                <string>fb-messenger-share-api</string>
                <string>fbauth2</string>
        </array>
        <!-- URL scheme required by native Google Sign-In so Google can redirect
             back into the app after authentication.

             ┌─ ACTION REQUIRED (see GOOGLE_SETUP.md) ─────────────────────────────┐
             │ Replace REVERSED_CLIENT_ID below with the "Reversed client ID" of   │
             │ your iOS OAuth client from Google Cloud Console.                     │
             │                                                                      │
             │ If your iOS Client ID is:                                            │
             │   123456789-abcdefg.apps.googleusercontent.com                       │
             │ then the Reversed client ID (what goes below) is:                    │
             │   com.googleusercontent.apps.123456789-abcdefg                       │
             └──────────────────────────────────────────────────────────────────────┘ -->
        <key>CFBundleURLTypes</key>
        <array>
                <dict>
                        <key>CFBundleURLSchemes</key>
                        <array>
                                <string>com.googleusercontent.apps.YOUR_REVERSED_IOS_CLIENT_ID_HERE</string>
                        </array>
                </dict>
        </array>
        <!-- The app uses only standard/exempt encryption (HTTPS). Declaring this
             avoids the "export compliance" prompt on every TestFlight upload. -->
        <key>ITSAppUsesNonExemptEncryption</key>
        <false/>
</dict>
</plist>
