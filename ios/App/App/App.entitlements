<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Push Notifications entitlement.
		"production" is used for App Store / TestFlight builds.
		The App Store distribution provisioning profile must have the
		Push Notifications capability enabled for an explicit App ID.
	-->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
